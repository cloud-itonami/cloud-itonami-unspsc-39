(ns elecinstall.advisor
  "DiagnosticsAdvisor -- the *contained intelligence node* for the
  independent solar and EV-charging install-and-diagnostics
  coordination actor.

  It normalizes panel/charger diagnostic-reading patches (fault-type/
  voltage/current), drafts a repair/install-visit scheduling proposal
  against a site, drafts a safety-concern flag, and drafts a
  commissioning-record coordination proposal against a circuit.
  CRITICAL: it is a smart-but-untrusted advisor. It returns a
  *proposal* (with a rationale + the fields it cited), never a
  committed record and NEVER a real circuit-actuation (energizing/
  de-energizing, bypassing lockout/tagout) or interconnection-
  approval/commissioning-authority certification -- see README `What
  this actor does NOT do`. Every output is censored downstream by
  `elecinstall.governor` before anything touches the SSoT.

  Like every sibling actor's advisor, this is a deterministic mock so
  the actor graph runs offline and the governor contract is exercised
  end-to-end. In production this calls a real LLM (kotoba-llm or
  equivalent) with the same proposal shape.

  Proposal shape (all kinds):
    {:summary    str            ; human-facing draft / finding
     :rationale  str            ; why -- informational only, NOT trusted
                                 ; by the governor for any ground-truth
                                 ; check (see `elecinstall.governor`)
     :cites      [kw|str ..]    ; fields the advisor used
     :effect     kw             ; how a commit would mutate the SSoT --
                                 ; ALWAYS one of the closed
                                 ; #{:circuit/upsert :repair/schedule
                                 ; :safety-concern/flag
                                 ; :commissioning/propose} propose-
                                 ; shaped effects, NEVER a direct
                                 ; circuit-actuation effect
     :stake      kw|nil         ; :coordination/safety-concern | nil
     :confidence 0..1}

  CRITICAL invariant this advisor upholds: every request it is asked to
  route MUST itself carry `:effect :propose` (the request-level
  contract every caller of this actor agrees to) --
  `elecinstall.governor` HARD-holds any request that doesn't, so a
  mis-wired caller can never reach a commit path even if this advisor
  were compromised."
  (:require #?(:clj  [kotoba.lang.edn :as edn]
               :cljs [cljs.reader :as edn])
            [kotoba.lang.text :as str]
            [elecinstall.registry :as registry]
            [elecinstall.store :as store]
            [langchain.model :as model]))

(defn- log-diagnostic-reading
  "Panel/charger diagnostic-reading intake upsert -- the advisor only
  normalizes/validates the patch; it does not invent the circuit's
  fault-type, voltage, current, or verification status. High
  confidence, low stakes -- administrative logging, not an operational
  decision."
  [_db {:keys [patch]}]
  {:summary    (str "診断読み取り記録更新: " (pr-str (keys patch)))
   :rationale  "入力patchの正規化のみ。新規事実の生成なし。"
   :cites      (vec (keys patch))
   :effect     :circuit/upsert
   :value      patch
   :stake      nil
   :confidence 0.95})

(defn- schedule-repair
  "Draft a repair/install-visit scheduling proposal against a site.
  The advisor reports what it can see (site verified?/registered?) in
  its rationale, but `elecinstall.governor` NEVER trusts this report
  -- it independently re-derives verified?/registered? from the
  site's own stored fields before any commit is possible."
  [db {:keys [subject value]}]
  (let [site-id (:site-id value)
        s (store/site db site-id)
        ready? (and s (registry/site-ready? s))]
    {:summary    (str subject " 向け修理/設置訪問予定提案 (" (:repair-type value) ")"
                      (when s (str " site=" site-id)))
     :rationale  (if s
                   (str "site-verified?=" (registry/site-verified? s)
                        " site-registered?=" (registry/site-registered? s)
                        " actuate-circuit?=" (boolean (:actuate-circuit? value)))
                   (str site-id " が見つかりません"))
     :cites      (if s [site-id] [])
     :effect     :repair/schedule
     :value      value
     :stake      nil
     :confidence (if (and ready? (not (:actuate-circuit? value))) 0.9 0.3)}))

(defn- flag-safety-concern
  "Draft a live-circuit/grid-interconnection/thermal-runaway-risk
  concern. ALWAYS `:stake :coordination/safety-concern` -- a safety
  concern is NEVER a proposal the advisor may quietly downgrade to
  low-stakes, and it is never gated on the referenced circuit/site
  being verified (a concern can be raised about ANY circuit or site,
  verified or not -- see README `What this actor does NOT do` re:
  never blocking safety-relevant reporting on an administrative
  technicality). See `elecinstall.phase`: no phase ever adds this op
  to a phase's `:auto` set; `elecinstall.governor` also always
  escalates on `:coordination/safety-concern`. Two independent layers
  agree, deliberately."
  [db {:keys [subject value]}]
  (let [circuit-id (:circuit-id value)
        c (and circuit-id (store/circuit db circuit-id))]
    {:summary    (str subject " 向け安全懸念報告 (" (:severity value) ")"
                      (when c (str " circuit=" circuit-id)))
     :rationale  (str "severity=" (:severity value) " description=" (:description value))
     :cites      (if c [circuit-id] [])
     :effect     :safety-concern/flag
     :value      value
     :stake      :coordination/safety-concern
     :confidence 0.9}))

(defn- issue-commissioning-record
  "Draft a commissioning-record coordination proposal against a
  circuit. The advisor passes through the caller's own claimed load
  quantity -- it does NOT invent one, and `elecinstall.governor` NEVER
  trusts it: it independently recomputes whether the circuit's own
  cumulative-committed load plus this claim would exceed the circuit's
  own recorded rated capacity before any commit is possible."
  [db {:keys [subject value]}]
  (let [circuit-id (:circuit-id value)
        c (store/circuit db circuit-id)
        ready? (and c (registry/circuit-ready? c))
        over-capacity? (and c (registry/load-exceeds-rated-capacity?
                               c (:load-amps value)))]
    {:summary    (str subject " 向けコミッショニング記録提案 ("
                      (:load-amps value) " A)"
                      (when c (str " circuit=" circuit-id)))
     :rationale  (if c
                   (str "circuit-verified?=" (registry/circuit-verified? c)
                        " circuit-registered?=" (registry/circuit-registered? c)
                        " over-rated-capacity?=" over-capacity?)
                   (str circuit-id " が見つかりません"))
     :cites      (if c [circuit-id] [])
     :effect     :commissioning/propose
     :value      value
     :stake      nil
     :confidence (if (and ready? (not over-capacity?)) 0.9 0.3)}))

(defn infer
  "Route a request to the right proposal generator.
  request: {:op kw :effect :propose :subject id ...op-specific...}"
  [db {:keys [op] :as request}]
  (case op
    :log-diagnostic-reading      (log-diagnostic-reading db request)
    :schedule-repair              (schedule-repair db request)
    :flag-safety-concern          (flag-safety-concern db request)
    :issue-commissioning-record   (issue-commissioning-record db request)
    {:summary "未対応の操作" :rationale (str op) :cites []
     :effect :noop :stake nil :confidence 0.0}))

;; ----------------------------- Advisor protocol -----------------------------

(defprotocol Advisor
  (-advise [advisor store request] "store + request -> proposal map"))

(defn mock-advisor
  "The deterministic advisor (the `infer` logic above). Default everywhere."
  [] (reify Advisor (-advise [_ st req] (infer st req))))

(def ^:private system-prompt
  (str "あなたは太陽光・EV充電設置/診断事業者の助言者です。"
       "与えられた事実のみに基づき、提案を1つだけEDNマップで返します。"
       "説明や前置きは一切書かず、EDNだけを出力します。\n"
       "キー: :summary(人向けドラフト) :rationale(根拠/必ず事実から) "
       ":cites(使った事実キーのベクタ) "
       ":effect(:circuit/upsert|:repair/schedule|"
       ":safety-concern/flag|:commissioning/propose) "
       ":stake(:coordination/safety-concern か nil) :confidence(0..1)。\n"
       "重要: 未検証または未登録のサイト・回路に対する作業を提案してはいけません。"
       "活線状態の回路のエネルギー投入/遮断や遮断器の直接操作(actuate)を絶対に提案してはいけません"
       "(この actor は提案のみを行い、実行は一切行いません)。"
       "系統連系承認・コミッショニング認定を自己発行する提案をしてはいけません。"
       "負荷量を偽って報告してはいけません。"))

(defn- facts-for [st {:keys [op subject value]}]
  (case op
    :log-diagnostic-reading       {:circuit (store/circuit st subject)}
    :schedule-repair               {:site (store/site st (:site-id value))}
    :flag-safety-concern           {:circuit (and (:circuit-id value)
                                                   (store/circuit st (:circuit-id value)))}
    :issue-commissioning-record    {:circuit (store/circuit st (:circuit-id value))}
    {}))

(defn- parse-proposal
  "Parse the model's EDN proposal defensively. Any parse/shape failure
  yields a safe low-confidence noop so `elecinstall.governor`
  escalates/holds -- an LLM hiccup can never auto-schedule a repair,
  auto-flag a concern, or auto-issue a commissioning record."
  [content]
  (let [p (try (edn/read-string (str/trim (str content)))
               (catch #?(:clj Exception :cljs :default) _ nil))]
    (if (map? p)
      (-> p
          (update :cites #(vec (or % [])))
          (update :confidence #(if (number? %) (double %) 0.0))
          (update :effect #(or % :noop)))
      {:summary "LLM応答を解釈できませんでした" :rationale (str content)
       :cites [] :effect :noop :stake nil :confidence 0.0})))

(defn llm-advisor
  "An advisor backed by a `langchain.model/ChatModel` (real inference)."
  ([chat-model] (llm-advisor chat-model {}))
  ([chat-model gen-opts]
   (reify Advisor
     (-advise [_ st req]
       (let [msgs [{:role :system :content system-prompt}
                   {:role :user :content (str "操作: " (:op req)
                                              "\n対象: " (:subject req)
                                              "\n事実: " (pr-str (facts-for st req)))}]
             resp (model/-generate chat-model msgs gen-opts)]
         (parse-proposal (:content resp)))))))

(defn trace
  "Decision-grounded audit record -- persisted to the :audit channel."
  [request proposal]
  {:t          :elecinstall-advisor-proposal
   :op         (:op request)
   :subject    (:subject request)
   :summary    (:summary proposal)
   :rationale  (:rationale proposal)
   :cites      (:cites proposal)
   :confidence (:confidence proposal)})
